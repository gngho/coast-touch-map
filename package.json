{
  "name": "coast-touch-map",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "wrangler deploy --dry-run --outdir dist/cloudflare",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "build:sites": "node build.mjs",
    "dev:cloudflare": "wrangler dev",
    "cf:configure": "node scripts/cloudflare-config.mjs --write",
    "cf:check": "node scripts/cloudflare-config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run cf:check && npm test && npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.8",
    "drizzle-orm": "0.44.7",
    "esbuild": "0.25.12",
    "wrangler": "4.143.0"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
