{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coast-touch-map",
  "main": "server/cloudflare-worker.mjs",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "coast-touch-map",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "drizzle"
  }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ACCESS_ALLOWED_EMAIL": "rudgh0862@gmail.com"
  }
}
